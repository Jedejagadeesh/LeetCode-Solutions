class Solution {
public:
    int longestPalindrome(string s) {
        unordered_set<char> st;
        int length = 0;

        for(char c : s){
            if(st.count(c)){
                length += 2;   // pair found
                st.erase(c);   // remove the pair
            } else {
                st.insert(c);  // first occurrence
            }
        }

        // If set not empty → we have some single chars left → can put 1 in middle
        if(!st.empty()) length++;

        return length;
   }
};
