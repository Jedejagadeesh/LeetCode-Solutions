class Solution {
public:
    int sumIndicesWithKSetBits(vector<int>& nums, int k) {
        int sum = 0;

        for (int i = 0; i < nums.size(); i++) {
            int j = i;
            int count = 0;

            while (j > 0) {
                if (j & 1) count++;
                j >>= 1;
            }

            if (count == k)
                sum += nums[i];
        }

        return sum;
    }
};
Input: nums = [5,10,1,5,2], k = 1
Output: 13
