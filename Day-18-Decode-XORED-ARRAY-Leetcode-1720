class Solution 
{
public:
    vector<int> decode(vector<int>& encoded, int first) {
        vector<int>arr;
        arr.push_back(first);
        int l=first;
        for(int i=0;i<encoded.size();i++){
          l=l^encoded[i];
          arr.push_back(l);
        }
    return arr;
    }
};
Input: encoded = [1,2,3], first = 1
Output: [1,0,2,1]
