class Solution {
public:
    bool searchMatrix(vector<vector<int>>& matrix, int target) {
      int n=matrix.size()-1;
      int left=0,right=n;
      while(left<=right){
        int m=matrix[left].size()-1;
        int l=0,r=m;
        while(l<=r){
        int x=(l+r)/2;
        if(matrix[left][x]==target){
         return true;
         break;
        }
        else if(matrix[left][x]>target){
            r=x-1;
        }
        else{
            l=x+1;
        }
        }
        left++;
      }  
      return false;
    }
};

