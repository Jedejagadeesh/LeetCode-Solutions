class Solution {
public:
    int search(vector<int>& nums, int target) {
        sort(nums.begin(),nums.end());
        int n=nums.size();
        int right=n;
        int left=0;
        while(left<right){
            int mid=(left+right)/2;
            if(nums[mid]==target){
                return mid;
            }
            else if(nums[mid]<target){
                left++;
            }
            else{
                right--;
            }
        }
        return -1;
    }
};
Input: nums = [-1,0,3,5,9,12], target = 9
Output: 4
