class Solution {
public:
    int bitwiseComplement(int n) {
     int x=1;
     int m=n;
     int bit=0;
     if(n==0) return 1;
     while(n>1){
        if(n%2>=0) bit++;
        n=n/2;
     }
     if(n==1) bit++;
     int mask=(1<<bit)-1;
     int res=(~m)&mask;
     return res;  
    }
};
Input: n = 5;
Output:2;
