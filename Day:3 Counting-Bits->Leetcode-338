class Solution {
public:
    vector<int> countBits(int n) {
        vector<int>hlo;
        for(int i=0;i<=n;i++){
        int m=i;
        int count=0;
        while(m>=1){
            if(m%2==1)count++;
        m=m/2;
        }
        hlo.push_back(count);
        }
        return hlo;
    }
}; 
Input: n = 2
Output: [0,1,1]
Explanation:
0 --> 0
1 --> 1
2 --> 10
