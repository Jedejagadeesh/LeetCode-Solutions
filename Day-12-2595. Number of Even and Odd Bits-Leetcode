class Solution {
public:
    vector<int> evenOddBit(int n) {
     int even=0;
     int odd=0;
     vector<int>arr;
     for(int i=0;i<32;i++){
        if((n&(1<<i)&&(i%2==0)))even++;
     }  
     for(int j=0;j<32;j++){
    if((n&(1<<j))&&(j%2==1))odd++;
     } 
     arr.push_back(even);
     arr.push_back(odd);
     return arr;
    }
};
Input: n = 50

Output: [1,2]
