class Solution {
public:
    bool hasAlternatingBits(int n) {
        vector<int>arr;
        while(n!=0){
        int m=n%2;
        if(m==1){
            arr.push_back(m);
        }
        else{
            arr.push_back(m);
        }
        n=n/2;
        }
for(int j=1;j<arr.size();j++){
if(arr[j-1]==arr[j]){ 
     return false;
}
}
return true;
    }
};
Input: n = 5
Output: true
