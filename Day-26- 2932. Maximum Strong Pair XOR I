class Solution {
public:
    int maximumStrongPairXor(vector<int>& nums) {
    int _max=INT_MIN;
     for(int i=0;i<nums.size();i++){
    for(int j=i;j<nums.size();j++){
      int c=abs(nums[i]-nums[j]);
      int d=min(nums[i],nums[j]);
      if(c<=d){
        int l=nums[i]^nums[j];
       _max=max(_max,l);
      }
    }
     }   
     return _max;
    }
};
Input: nums = [1,2,3,4,5]
Output: 7
