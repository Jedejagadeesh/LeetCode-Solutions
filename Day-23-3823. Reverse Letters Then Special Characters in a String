class Solution {
public:
    string reverseByType(string s) {
    string alpha="";
    string chara="";
    int n=s.size();
    for(int i=n-1;i>-1;i--){
    if(isalpha(s[i])){
        chara+=s[i];
    }
    else{
        alpha+=s[i];
    }
    }
    string jagan;
    int i=0;
    int j=0;
    for(int x=0;x<n;x++){
    if(isalpha(s[x])){
        jagan+=chara[i];
        i++;
    }
    else{
        jagan+=alpha[j];
        j++;
    }
    }
    return jagan;
    }
};
Input: s = ")ebc#da@f("

Output: "(fad@cb#e)"

