class Solution {
public:
    vector<vector<int>> subsets(vector<int>& nums) {
        vector<vector<int>>arr;
        int n=nums.size();
        int subset=(1<<n);
        for(int num=0;num<subset;num++){
            vector<int>hlo;
        for(int i=0;i<n;i++){
           if(num&(1<<i)){
             hlo.push_back(nums[i]);
           }
        }
        arr.push_back(hlo);
        }
        return arr;
    }
};
Example
Input: nums = [1,2,3]
Output: [[],[1],[2],[1,2],[3],[1,3],[2,3],[1,2,3]]
