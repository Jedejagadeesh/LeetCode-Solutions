class Solution {
public:
    bool divideArray(vector<int>& nums) {
    sort(nums.begin(),nums.end());
    int i=0;
    int j=1;
    int n=nums.size();
    int m=n/2;
    vector<vector<int>>arr;
    int count=0;
    while(i<n & j<n){
    if(nums[i]==nums[j]){
        arr.push_back({nums[i],nums[j]}); 
        i++;
         j++;
   }
  i++;
  j++;
    }
    return(arr.size()==m);
    }
}; 
Input: nums = [3,2,3,2,2,2]
Output: true
